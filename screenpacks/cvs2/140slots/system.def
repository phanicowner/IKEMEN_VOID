;-------------------------------------------------------------------
;Demo mode definition
[Demo Mode]
enabled = 1               ;Set to 1 to enable demo mode, 0 to disable
select.enabled = 0        ;Set to 1 to display select screen, 0 to disable
vsscreen.enabled = 0      ;Set to 1 to display versus screen, 0 to disable
title.waittime = 1020      ;Time to wait at title before starting demo mode
fight.endtime = 1500      ;Time to display the fight before returning to title
fight.playbgm = 1         ;Set to 1 to enable in-fight BGM, 0 to disable
fight.bars.display = 0    ;Set to 1 to display lifebar, 0 to disable
intro.waitcycles = 0      ;Cycles to wait before intro cutscene is played again
debuginfo = 0             ;Set to 0 to hide debugging info (debug mode only)

;-------------------------------------------------------------------
;Continue screen definition
[Continue Screen]
enabled = 1               ;Set to 1 to show continue screen, 0 to disable
pos = 318,140

;-------------------------------------------------------------------
;Game over screen definition
[Game Over Screen]
enabled = 1              	;Set to 1 to show game over screen, 0 to disable
storyboard = gameover.def             ;Game over storyboard filename

;-------------------------------------------------------------------
;Victory screen definition
;This is the screen that is shown when you win a match in arcade mode.
;It will not be displayed on the last match of arcade mode.
[Victory Screen]
enabled = 1
time = 520                ;Time to show screen
fadein.time = 20
fadeout.time = 20
p1.offset = 200,58
p1.spr = 9000,1
p1.facing = 1
p1.scale = 1,1
p1.window = 0,0, 639,338
p1.layerno = 0
p1.name.font = -1
;Win quote text
winquote.text = "No match for my special moves, huh? Better luck next time!" ;Default win quote text to show
winquote.offset = 120,390
winquote.font = 3,0,1,0,255,255
winquote.window = 120,0, 520,480
winquote.textwrap = w     ;Word wrap

