;----------------------------
[Info]
name = "Capcom vs. SNK 2"		;Name of motif
author = "Elecbyte"       			;Motif author name
localcoord = 640,480

;----------------------------
[Files]
spr = system.sff          	;Filename of sprite data
snd = system.snd          	;Filename of sound data
logo.storyboard = logo.def ;Logo storyboard definition (optional)
intro.storyboard =   ;Intro storyboard definition (optional)
select = select.def       	;Character and stage selection list
fight = fight.def         	;Fight definition filename
font1 = font/CVS2-SXmenu.fnt
font2 = font/namefnt.fnt
font3 = font/msgothic-tt20.def
font4 = font/f-6x9.def
font5 = font/stagefnt.fnt

;----------------------------
[Music]
title.bgm = data/cvs2/sound/title.mp3
title.bgm.loop = 1
select.bgm = data/cvs2/sound/select.mp3
select.bgm.loop = 1
vs.bgm = data/cvs2/sound/versus.mp3
vs.bgm.loop = 0
victory.bgm = data/cvs2/sound/victory.mp3
victory.bgm.loop = 0

;-------------------------------------------------------------------
[Title Info]
fadein.time = 20
fadeout.time = 20
menu.pos = 0,479
menu.item.font = 1,0,-1
menu.item.active.font = 1,0,1
menu.item.spacing = 0,0
menu.itemname.arcade = "A"             ;"ARCADE"
menu.itemname.versus = "B"             ;"VS MODE"
menu.itemname.teamarcade = "C"         ;"TEAM ARCADE"
menu.itemname.teamversus = "D"         ;"TEAM VS"
menu.itemname.teamcoop = "E"           ;"TEAM CO-OP"
menu.itemname.survival = "F"           ;"SURVIVAL"
menu.itemname.survivalcoop = "G"       ;"SURVIVAL CO-OP"
menu.itemname.training = "H"           ;"TRAINING"
menu.itemname.watch = "I"              ;"WATCH"
menu.itemname.options = "J"            ;"OPTIONS"
menu.itemname.exit = "K"               ;"EXIT"
menu.window.margins.y = 480,480
menu.window.visibleitems = 1
menu.boxcursor.visible = 0
cursor.move.snd = 100,0
cursor.done.snd = 100,1
cancel.snd = 100,2

